# Base URL of the Express API, including the /api/v1 prefix.
# Local:      http://localhost:5000/api/v1
# Production: https://api.isoftwarecare.com/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000/api/v1

# Canonical origin of THIS site. Drives metadata, Open Graph, robots.txt and
# sitemap.xml, so a wrong value here silently poisons every absolute URL.
# Local:      http://localhost:3000
# Production: https://isoftwarecare.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com booking target: "username" or "username/event-slug".
# A full URL (https://cal.com/isoftwarecare) is also accepted and normalised.
# Leave blank to disable booking — the UI falls back to /book and the contact form.
NEXT_PUBLIC_CAL_LINK=isoftwarecare
# Only change for Cal.com EU (https://cal.eu) or a self-hosted instance.
NEXT_PUBLIC_CAL_ORIGIN=https://cal.com

# NOTE: no secrets belong in this file. Everything here ships to the browser.
# Plunk email keys live in ../server/.env.
